<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="../Styles/HiveHUD.uss" />
    <ui:VisualElement name="workspace-root" class="workspace-card">
        <ui:VisualElement class="cyber-header">
            <ui:Label name="agent-name" text="PRIME" class="cyber-title" />
            <ui:VisualElement style="flex-grow: 1;" />
            <ui:Label name="agent-status" text="Available" class="cyber-badge" />
        </ui:VisualElement>

        <ui:Label name="agent-role" text="Agency Director" style="color: var(--text-muted); margin-bottom: 6px;" />
        
        <ui:VisualElement style="margin-bottom: 8px;">
            <ui:Label text="Active Focus:" style="font-size: 11px; color: var(--accent-teal);" />
            <ui:Label name="current-task" text="None" style="font-size: 12px;" />
        </ui:VisualElement>

        <ui:VisualElement name="hologram-container" style="height: 60px; margin-bottom: 8px; border-width: 1px; border-color: #164e63; border-radius: 4px;" />
        
        <ui:Label text="Tasks:" style="font-size: 11px; color: var(--accent-teal); margin-bottom: 4px;" />
        <ui:ListView name="task-list" style="height: 90px; margin-bottom: 8px;" />
        
        <ui:VisualElement name="network-connections" style="flex-direction: row; margin-bottom: 8px;" />

        <ui:Button name="chat-button" text="Open Channel" class="cyber-button" />
    </ui:VisualElement>
</ui:UXML>
