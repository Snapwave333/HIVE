<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="../Styles/HiveHUD.uss" />
    <ui:VisualElement class="message-item">
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 2px;">
            <ui:Label name="sender" text="PRIME" style="-unity-font-style: bold; color: var(--accent-green);" />
            <ui:Label name="time" text="12:00:00" style="font-size: 10px; color: #64748b;" />
        </ui:VisualElement>
        <ui:Label name="content" text="Directive acknowledged." style="white-space: normal;" />
    </ui:VisualElement>
</ui:UXML>
