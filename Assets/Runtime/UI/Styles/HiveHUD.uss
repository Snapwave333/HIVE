:root {
    --bg-dark: #07090b;
    --panel-bg: rgba(11, 15, 18, 0.88);
    --panel-border: #1f3025;
    --accent-green: #85D94B;
    --accent-teal: #42CFC4;
    --text-primary: #d1fae5;
    --text-muted: #6ee7b7;
    --panel-spacing: 12px;
    --font-size: 13px;
    font-size: var(--font-size);
    color: var(--text-primary);
}

.dense {
    --panel-spacing: 6px;
    --font-size: 11px;
}

.comfortable {
    --panel-spacing: 12px;
    --font-size: 13px;
}

.focus {
    --panel-spacing: 16px;
    --font-size: 15px;
}

.hive-panel {
    background-color: var(--panel-bg);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 6px;
    padding: var(--panel-spacing);
}

.cyber-header {
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--panel-border);
    padding-bottom: 6px;
    margin-bottom: 8px;
}

.cyber-title {
    font-size: 15px;
    color: var(--accent-green);
    -unity-font-style: bold;
}

.cyber-badge {
    padding: 3px 8px;
    border-radius: 4px;
    background-color: #164e63;
    color: #67e8f9;
    font-size: 11px;
}

.command-bar {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    height: 380px;
}

.sidebar-panel {
    position: absolute;
    top: 20px;
    left: 20px;
    bottom: 20px;
    width: 280px;
}

.workspace-card {
    width: 320px;
    background-color: rgba(7, 10, 12, 0.92);
    border-width: 1px;
    border-color: var(--accent-green);
    border-radius: 8px;
    padding: 12px;
}

.message-item {
    padding: 6px 10px;
    margin-bottom: 4px;
    border-radius: 4px;
    background-color: rgba(20, 30, 25, 0.5);
}

.toast-container {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 340px;
}

.history-panel {
    position: absolute;
    top: 20px;
    right: 20px;
    bottom: 20px;
    width: 360px;
    background-color: rgba(10, 14, 16, 0.95);
    border-width: 1px;
    border-color: var(--accent-teal);
    border-radius: 6px;
    padding: 12px;
}
