{
  "version": "1.1",
  "recovery": {
    "transactionsDir": ".hive/recovery/transactions",
    "checkpointsDir": ".hive/recovery/checkpoints",
    "worktreesDir": ".hive/worktrees",
    "quarantineDir": ".hive/quarantine",
    "lockFile": ".hive/recovery/supervisor.lock",
    "heartbeatFile": ".hive/recovery/watchdog.heartbeat",
    "transactionTimeoutSeconds": 600,
    "watchdogIntervalSeconds": 10
  },
  "tiers": {
    "tier3_prohibited": [
      "scripts/recovery/**",
      ".hive/recovery/**",
      "scripts/recovery/hive_recovery.py",
      "scripts/recovery/hive_recovery.cmd",
      "scripts/recovery/recovery_config.json"
    ],
    "tier2_owner_required": [
      "Assets/Runtime/Core/**",
      "Assets/Runtime/Coding/**",
      "Assets/Runtime/Security/**",
      "Assets/Runtime/Persistence/**",
      "Assets/Runtime/LLM/**",
      "Assets/Scenes/**",
      "ProjectSettings/**",
      "Packages/manifest.json",
      ".github/workflows/**",
      "Assets/StreamingAssets/agents/**"
    ],
    "tier1_autonomous": [
      "Assets/Runtime/UI/Styles/**",
      "Assets/Runtime/Skills/**",
      "Assets/Runtime/Voice/**",
      "docs/**",
      "README.md",
      "Screenshots/**"
    ]
  }
}
